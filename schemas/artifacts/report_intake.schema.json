{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/report_intake",
  "title": "Report Intake",
  "type": "object",
  "required": ["version", "sources"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "media_type", "sha256", "version_label"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "media_type": { "type": "string", "enum": ["pdf", "docx", "image", "notebook_export", "web"] },
          "display_name": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "version_label": { "type": "string", "minLength": 1 },
          "page_count": { "type": ["integer", "null"], "minimum": 1 },
          "as_of": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "metadata": { "type": "object" }
  },
  "additionalProperties": false
}
