{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/scene_plan",
  "title": "Scene Plan",
  "description": "Ordered scene list produced by the Scene Planner agent.",
  "type": "object",
  "required": ["version", "scenes"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "style_playbook": { "type": "string", "description": "Name of the active style playbook" },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "description", "start_seconds", "end_seconds"],
        "properties": {
          "id": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["talking_head", "broll", "animation", "character_scene", "diagram", "text_card", "transition", "generated", "screen_recording"]
          },
          "description": { "type": "string" },
          "visual_intent": {
            "type": "string",
            "minLength": 1,
            "description": "Human-readable picture/action intent, kept separate from the exact provider prompt and generated result"
          },
          "start_seconds": { "type": "number", "minimum": 0 },
          "end_seconds": { "type": "number", "minimum": 0 },
          "script_section_id": { "type": "string" },
          "framing": { "type": "string" },
          "movement": { "type": "string" },
          "transition_in": { "type": "string" },
          "transition_out": { "type": "string" },
          "overlay_notes": { "type": "string" },
          "layout_notes": {
            "type": "string",
            "description": "Camera, acting, and layout detail supporting the eight-column scene-plan view"
          },
          "t2i_prompt": {
            "type": "string",
            "description": "Exact prompt used only for the scene-plan layout reference / still. Independent of visual_intent."
          },
          "i2v_prompt": {
            "type": "string",
            "description": "Exact provider prompt for motion (H3/I2V). Independent of visual_intent and of t2i_prompt. Required by eight-column presentation when motion_route is H3."
          },
          "avoid": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Retention / negative constraints compiled into t2i_prompt and i2v_prompt"
          },
          "anchor_refs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "description": "STYLE/CHARACTER/SCENE/PROP/COMPOSITION/SOUND ids this cut binds. Not LibTV node_key."
          },
          "audience_state_change": {
            "type": "string",
            "description": "What the audience now knows or feels after this cut. Not the picture description."
          },
          "audience_state_before": {
            "type": "string",
            "description": "Audience knowledge/feeling entering this cut. Must differ from audience_state_change."
          },
          "anchor_bindings": {
            "type": "array",
            "description": "anchor_refs resolved to path+sha256, or status=unresolved. Not LibTV node_key.",
            "items": {
              "type": "object",
              "required": ["id", "kind", "status"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "kind": { "type": "string" },
                "status": { "type": "string", "enum": ["bound", "unresolved"] },
                "path": { "type": ["string", "null"] },
                "sha256": { "type": ["string", "null"] },
                "aspect_note": { "type": ["string", "null"] },
                "role": {
                  "type": "string",
                  "description": "IDENTITY_REFERENCE / SCENE_REFERENCE / PROP_REFERENCE / COMPOSITION_REFERENCE / STYLE_REFERENCE / SOUND_REFERENCE. Not a shot keyframe."
                }
              },
              "additionalProperties": false
            }
          },
          "shot_profile": {
            "type": "object",
            "description": "Director class for this cut. Temporal beats must match this class.",
            "properties": {
              "framing_class": { "type": "string" },
              "action_type": { "type": "string" },
              "visible_subject": { "type": "string" }
            },
            "additionalProperties": false
          },
          "first_frame_readiness": {
            "type": "object",
            "description": "local_image is not shot_ready. H3 FL2VA requires a 9:16 SHOT_KEYFRAME.",
            "properties": {
              "role": { "type": "string" },
              "shot_ready": { "type": "boolean" },
              "path": { "type": ["string", "null"] },
              "composition_id": { "type": ["string", "null"] },
              "aspect": { "type": ["string", "null"] },
              "blockers": { "type": "array", "items": { "type": "string" } },
              "h3_dispatch_allowed": { "type": "boolean" }
            },
            "additionalProperties": false
          },
          "local_motion_fn": {
            "type": "string",
            "description": "Deterministic local motion function when motion_obligation is LOCAL. Not ffmpeg-hold."
          },
          "h3_ir": {
            "type": "object",
            "description": "Structured H3 cut spec consumed by lib.h3_context_ir.compile_from_scene. Not a dispatch, not PASS."
          },
          "temporal_beats": {
            "type": "array",
            "description": "Declared time grammar inside this cut. One camera setup; split the row if you need another.",
            "items": {
              "type": "object",
              "required": ["kind", "t_start", "t_end"],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": ["HOLD", "CAMERA", "AMBIENT", "CHARACTER_PERFORMANCE", "GRAPHIC", "PROP"]
                },
                "t_start": { "type": "number", "minimum": 0 },
                "t_end": { "type": "number", "minimum": 0 },
                "action": {
                  "type": "string",
                  "description": "What happens in this beat. Required for PERFORMANCE/LOCAL; empty HOLD is allowed."
                }
              },
              "additionalProperties": false
            }
          },
          "dialogue": {
            "type": "string",
            "description": "Human narration or character dialogue shown in the eight-column view"
          },
          "voice_segment_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "description": "Join from this cut to canonical voice_timing.segments[].id"
          },
          "animation_class": {
            "type": "string",
            "enum": ["LIMITED", "I2V_STANDARD", "I2V_HARD"],
            "description": "Planned motion class. Optional. Missing class drafts from motion_obligation: NONE/LOCAL → LIMITED, PERFORMANCE/INTERACTION → I2V_HARD. LIMITED plus PERFORMANCE is a compile failure. Dispatch is illegal until lib/shot_production_gate reports production_ready."
          },
          "motion_obligation": {
            "type": "string",
            "enum": ["NONE", "LOCAL", "PERFORMANCE", "INTERACTION"],
            "description": "Declared time grammar. PERFORMANCE/INTERACTION default to H3. Cannot be satisfied by local_compose, ffmpeg loop, or still+zoom."
          },
          "performance_intent": {
            "type": "string",
            "description": "What the character does in time. If this names locomotion or acting, motion_obligation is PERFORMANCE unless explicitly NONE with intentional_hold."
          },
          "intentional_hold": {
            "type": "boolean",
            "description": "Required when motion_obligation is NONE on a character cut. Silent still-loop without this flag is illegal for PERFORMANCE."
          },
          "renderer": {
            "type": "string",
            "description": "Intended renderer family. local_compose/ffmpeg/remotion are illegal on PERFORMANCE/INTERACTION."
          },
          "render": {
            "type": "object",
            "description": "Factory routing hint for SHOT_RENDER_PACKAGE. Does not authorize dispatch_cut. Cursor still must not impersonate Prime.",
            "additionalProperties": false,
            "properties": {
              "target": {
                "type": "string",
                "enum": ["local_h3", "local_deterministic", "runninghub", "xiaoyunque", "libtv"]
              },
              "stage": {
                "type": "string",
                "enum": ["PREVIS", "DRAFT", "FINAL", "HERO"]
              },
              "profile": {
                "type": "string",
                "minLength": 1,
                "description": "Provider profile id, e.g. rh_h3_fl2va_final_v1. Not API parameters."
              }
            }
          },
          "character_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "description": "Character bible ids visible in this cut; identity L0 compares against OM-approved stills"
          },
          "costume_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "character_variant": {
            "type": "object",
            "description": "Phase × costume × view slot for this cut. still_refs are IDENTITY_REFERENCE, never SHOT_KEYFRAME / H3 Picture 1. Wardrobe lives here, not in visual_continuity_package.world_lock.",
            "required": ["character_id"],
            "additionalProperties": false,
            "properties": {
              "character_id": { "type": "string", "minLength": 1 },
              "phase": { "type": "string", "minLength": 1 },
              "costume": { "type": "string", "minLength": 1 },
              "view": {
                "type": "string",
                "enum": ["front_3q", "full_body", "front_face", "profile_left", "profile_right"]
              },
              "must_show": { "type": "string" },
              "still_refs": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 },
                "description": "Identity/costume stills. Illegal as start_frame_ref for H3."
              }
            }
          },
          "start_frame_ref": {
            "type": "string",
            "minLength": 1,
            "description": "Approved still or prior-cut frame used as the start frame"
          },
          "end_frame_ref": {
            "type": "string",
            "minLength": 1,
            "description": "Optional end still. Not part of the minimum visual contract; LIMITED drafts may omit it."
          },
          "primary_model": { "type": "string", "minLength": 1 },
          "fallback_models": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "continuity_from": {
            "type": "string",
            "minLength": 1,
            "description": "Earlier scenes[].id this cut must match for identity/costume/layout"
          },
          "voice_segment_refs": {
            "type": "array",
            "description": "Optional J/L-cut time ranges onto voice_timing.segments[].id; voice_segment_ids remains the join key",
            "items": {
              "type": "object",
              "required": ["segment_id"],
              "properties": {
                "segment_id": { "type": "string", "minLength": 1 },
                "start_ms": { "type": "integer", "minimum": 0 },
                "end_ms": { "type": "integer", "minimum": 0 }
              },
              "additionalProperties": false
            }
          },
          "generation_status": {
            "type": "string",
            "enum": ["pending", "submitted", "completed", "failed"],
            "default": "pending",
            "description": "OM-owned cut status. Pi may emit events; Pi must not write PASS/APPROVED/checkpoint."
          },
          "visual_ref": {
            "type": "object",
            "required": ["kind"],
            "properties": {
              "kind": { "type": "string", "enum": ["api_image", "local_image", "placeholder"] },
              "path": { "type": "string" },
              "placeholder_reason": { "type": "string" }
            },
            "additionalProperties": false
          },
          "reuse": {
            "type": "object",
            "required": ["source_cut_id", "kind"],
            "properties": {
              "source_cut_id": { "type": "string", "minLength": 1 },
              "kind": { "type": "string", "enum": ["same_layout", "same_position", "compatible_asset"] }
            },
            "additionalProperties": false
          },
          "sound_intent": {
            "type": "object",
            "required": ["se", "bgm_mood"],
            "properties": {
              "se": { "type": "array", "items": { "type": "string" } },
              "bgm_mood": { "type": "string" },
              "silence": { "type": "boolean", "default": false },
              "transition": { "type": "string" }
            },
            "additionalProperties": false
          },
          "image_provenance": {
            "type": "object",
            "required": ["provider", "model", "seed", "size", "request_id", "cost_or_plan_usage", "output_hash", "license_policy"],
            "properties": {
              "provider": { "type": "string", "minLength": 1 },
              "model": { "type": "string", "minLength": 1 },
              "seed": { "type": ["integer", "null"] },
              "size": { "type": "string", "minLength": 1 },
              "request_id": { "type": "string", "minLength": 1 },
              "cost_or_plan_usage": { "type": ["number", "string", "object"] },
              "output_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "license_policy": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          },
          "motion_route": {
            "type": "string",
            "enum": ["H3", "I2V", "T2V", "2_5D", "REMOTION", "PROGRAMMATIC", "HOLD"]
          },
          "world_state": { "type": "object" },
          "flags": { "type": "array", "items": { "type": "string" } },
          "review_decision": {
            "type": "string",
            "enum": ["pending", "keep", "change", "merge", "omit"],
            "default": "pending"
          },
          "review_notes": { "type": "string" },
          "merge_target_id": { "type": "string" },
          "shot_language": {
            "type": "object",
            "description": "Structured cinematography vocabulary for this scene",
            "properties": {
              "shot_size": {
                "type": "string",
                "enum": ["extreme_wide", "wide", "medium_wide", "medium", "medium_close", "close_up", "extreme_close_up", "over_shoulder", "insert", "establishing"]
              },
              "camera_movement": {
                "type": "string",
                "enum": ["static", "pan_left", "pan_right", "tilt_up", "tilt_down", "dolly_in", "dolly_out", "tracking_left", "tracking_right", "crane_up", "crane_down", "handheld", "steadicam", "whip_pan", "orbital", "zoom_in", "zoom_out", "rack_focus"]
              },
              "lens_mm": { "type": "integer", "enum": [14, 24, 35, 50, 85, 135, 200] },
              "lighting_key": {
                "type": "string",
                "enum": ["high_key", "low_key", "natural", "golden_hour", "blue_hour", "tungsten_warm", "neon", "silhouette", "rim_lit", "volumetric", "overcast_soft"]
              },
              "depth_of_field": { "type": "string", "enum": ["shallow", "medium", "deep"] },
              "color_temperature": { "type": "string", "enum": ["cool", "neutral", "warm", "mixed"] }
            },
            "additionalProperties": false
          },
          "shot_intent": {
            "type": "string",
            "description": "WHY this shot exists — what purpose it serves in the video"
          },
          "narrative_role": {
            "type": "string",
            "enum": ["establish_context", "introduce_subject", "build_tension", "deliver_payload", "transition", "emotional_beat", "evidence", "comparison", "resolution", "call_to_action"],
            "description": "What role this scene plays in the narrative structure"
          },
          "information_role": {
            "type": "string",
            "description": "What the viewer learns or feels from this scene"
          },
          "hero_moment": {
            "type": "boolean",
            "default": false,
            "description": "True if this is the visual peak of the video — deserves extra attention"
          },
          "character_actions": {
            "type": "array",
            "description": "Character-specific acting beats for rigged character animation scenes",
            "items": {
              "type": "object",
              "required": ["character_id", "action_sequence"],
              "properties": {
                "character_id": { "type": "string" },
                "emotion": { "type": "string" },
                "action_sequence": {
                  "type": "array",
                  "items": { "type": "string" },
                  "minItems": 1
                },
                "dialogue": { "type": "string" },
                "target": { "type": "string" },
                "notes": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "texture_keywords": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Visual texture descriptors: grain, clean, anamorphic, gritty, ethereal, etc."
          },
          "required_assets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": { "type": "string" },
                "description": { "type": "string" },
                "source": { "type": "string", "enum": ["generate", "source", "provided", "record"] }
              },
              "required": ["type", "description", "source"]
            }
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "metadata": {
      "type": "object",
      "description": "Job metadata. Limited Anime Studio identity lock: master_sheet_path / master_sheet_locked. Animatic is optional. render_allowed is derived by the minimum visual contract; a stored true cannot bypass missing stills."
    },
    "visual_continuity_package": {
      "type": "object",
      "description": "Hard-gate package for multi-mother visual continuity before assets",
      "required": ["generation_mode", "world_lock", "hero_prop_id", "camera_language"],
      "properties": {
        "generation_mode": {
          "type": "string",
          "enum": ["one_mother_edit", "multi_panel_one_request", "vector_primary"]
        },
        "world_lock": {
          "type": "object",
          "description": "Shared palette/material/hero props across mother frames. Character wardrobe, hair, and face belong on scenes[].character_variant, not here.",
          "minProperties": 1
        },
        "hero_prop_id": { "type": "string", "minLength": 1 },
        "camera_language": { "type": "string", "minLength": 1 },
        "alan_continuous_animation_ok": {
          "type": ["boolean", "null"],
          "description": "Human continuous-animation acceptance; default null until Alan reviews"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
