{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/repair_plan",
  "title": "Repair Plan",
  "description": "Local patch plan for failed segments only.",
  "type": "object",
  "required": ["version", "items"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "const": "repair-plan/v0.1" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["t_start", "t_end", "action", "scope"],
        "additionalProperties": false,
        "properties": {
          "t_start": { "type": "number" },
          "t_end": { "type": "number" },
          "action": { "type": "string" },
          "scope": { "type": "string", "enum": ["segment"] },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
