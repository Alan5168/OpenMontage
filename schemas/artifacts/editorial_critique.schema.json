{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/editorial_critique",
  "title": "Editorial Critique",
  "description": "Model judge against frozen intent. Findings must cite timestamps and frame ids. This artifact cannot PASS the loop by itself.",
  "type": "object",
  "required": ["version", "source_sha256", "findings"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "const": "editorial-critique/v0.1" },
    "source_sha256": { "type": "string", "minLength": 64, "maxLength": 64 },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "t_start",
          "t_end",
          "frame_ids",
          "intent_id",
          "failure_class",
          "evidence",
          "why_it_fails_intent"
        ],
        "additionalProperties": false,
        "properties": {
          "t_start": { "type": "number", "minimum": 0 },
          "t_end": { "type": "number", "minimum": 0 },
          "frame_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "intent_id": { "type": "string" },
          "failure_class": { "type": "string" },
          "evidence": { "type": "string", "minLength": 24 },
          "why_it_fails_intent": { "type": "string", "minLength": 24 }
        }
      }
    }
  }
}
