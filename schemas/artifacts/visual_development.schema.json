{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/visual_development",
  "title": "Visual Development",
  "type": "object",
  "required": ["version", "style_direction", "original_style_boundary", "continuity", "reuse_budget", "allowed_motion_routes"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "style_direction": { "type": "string", "minLength": 1 },
    "original_style_boundary": { "type": "string", "minLength": 1 },
    "continuity": {
      "type": "object",
      "required": ["characters", "world"],
      "properties": {
        "characters": { "type": "array", "items": { "type": "object" } },
        "world": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": false
    },
    "reuse_budget": {
      "type": "object",
      "required": ["max_new_layouts", "target_reuse_ratio"],
      "properties": {
        "max_new_layouts": { "type": "integer", "minimum": 1 },
        "target_reuse_ratio": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "allowed_motion_routes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["H3", "I2V", "T2V", "2_5D", "REMOTION", "PROGRAMMATIC", "HOLD"] }
    },
    "metadata": { "type": "object" }
  },
  "additionalProperties": false
}
